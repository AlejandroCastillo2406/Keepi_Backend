# Copia a .env y rellena valores reales.
#
# ---------------------------------------------------------------------------
# IMÁGENES (Cloudinary u otro CDN) — URL pública completa de cada PNG.
# El cliente de correo descarga la imagen desde esa URL; el backend no sirve PNG.
# ---------------------------------------------------------------------------

# Icono grande naranja con check (plantilla de confirmación de pago).
EMAIL_URL_ICON_CHECK=

# Icono pequeño de tarjeta junto al “método de pago” en el resumen del correo.
EMAIL_URL_ICON_CARD=

# Icono del correo de recordatorio de vencimiento de documentos.
EMAIL_URL_ICON_VENCIMIENTO=

# Imagen del pie (redes / branding) en plantillas de vencimiento.
EMAIL_URL_FOOTER_SOCIALS=

#
# ---------------------------------------------------------------------------
# ENLACES Y TEXTOS del HTML del correo (no son URLs de imágenes).
# ---------------------------------------------------------------------------

# URL a la que lleva el botón “Ir a mi cuenta” (web o deep link de la app).
EMAIL_LINK_ACCOUNT=

# URL del centro de ayuda (enlace “Centro de Ayuda” en el pie del correo de pago).
EMAIL_LINK_HELP=

# Correo de soporte: se muestra como texto y en mailto: (contacto).
EMAIL_SUPPORT_ADDRESS=

# Nombre corto de la marca (aparece en títulos HTML y en el asunto del correo).
EMAIL_BRAND_NAME=

# Razón social o nombre legal para la línea de copyright (© año …).
EMAIL_COPYRIGHT_LEGAL_NAME=

# Nombre que se muestra si el usuario no tiene nombre (plantillas de ejemplo / fallback).
EMAIL_PLACEHOLDER_DISPLAY_NAME=

#
# ---------------------------------------------------------------------------
# AMAZON SES — remitente verificado en SES (From).
# ---------------------------------------------------------------------------

# Dirección de correo que envía (debe estar verificada o dominio verificado en SES).
SES_FROM_EMAIL=

# Nombre visible del remitente (ej. “Keepi” junto al email en el cliente).
SES_FROM_NAME=

#
# ---------------------------------------------------------------------------
# API PÚBLICA — no es para imágenes de correo.
# ---------------------------------------------------------------------------

# URL base del backend (https://… sin / final). Ej.: OAuth, callback móvil Google
# cuando no se puede derivar la base desde GOOGLE_REDIRECT_URI.
PUBLIC_BASE_URL=
